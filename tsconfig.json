{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "components/Activities.jsx", "components/BootstrapClient.tsx", "components/Contact.jsx", "components/Hero.jsx", "components/Intro.jsx", "components/LandingPage.jsx", "components/Portfolio.jsx", "components/Pricing.jsx", "components/Process.jsx", "components/Services.jsx", "components/SiteFooter.jsx", "components/SiteHeader.jsx", "components/WhyUs.jsx"],
  "exclude": ["node_modules"]
}
